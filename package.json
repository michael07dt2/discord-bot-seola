{
  "name": "seola-bot",
  "version": "0.1.0",
  "description": "Discord bot for Seola",
  "author": "Minkyu Kim",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#*": "./src/*",
    "#util/*": "./src/util/*",
    "#db/*": "./src/db/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --watch src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop seola-bot",
    "pm2:restart": "pm2 restart seola-bot",
    "pm2:logs": "pm2 logs seola-bot",
    "pm2:status": "pm2 status",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:reload": "docker exec seola-bot pm2 reload seola-bot",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@huggingface/transformers": "^4.3.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "msedge-tts": "^2.1.1",
    "openai": "^7.50.0",
    "pg": "^8.23.1",
    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "//": "Fixes discord.js Dependency issue",
  "overrides": {
    "undici": "^6.29.1",
    "tar": "^7.5.22",
    "minimatch": "^11.0.4",
    "brace-expansion": "^1.1.21"
  },
  "allowScripts": {
    "@discordjs/opus@0.11.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "msedge-tts@2.1.1": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "youtube-dl-exec@3.1.19": true
  }
}
