# Discord Bot Credentials
APP_ID=your_discord_app_id
DISCORD_TOKEN=your_discord_bot_token
PUBLIC_KEY=your_discord_public_key

# Web Server & Dashboard
PORT=13000
DASHBOARD_URL=http://localhost:13000/dashboard

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/context

# Local LLM Backend (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Speech AI Pipeline (STT & TTS)
WHISPER_MODEL=onnx-community/whisper-small
TTS_PRESET=seola
COSYVOICE_INSTRUCT_TEXT="차갑고 감정이 절제된 어린 소녀의 목소리. 아리스보다 반 옥타브 낮고 차분한 톤으로, 억양의 높낮이 변화가 적고 기계처럼 또박또박 일정한 속도로 말한다."

# Self-Improvement Agent Paths (Optional)
# HERMES_BIN=/path/to/hermes
# AGY_BIN=/opt/homebrew/bin/agy
