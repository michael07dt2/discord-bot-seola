# Discord Bot Credentials
APP_ID=your_discord_app_id
DISCORD_TOKEN=your_discord_bot_token
PUBLIC_KEY=your_discord_public_key

# Web Server & Dashboard
PORT=13000
DASHBOARD_URL=http://localhost:13000/dashboard

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/context

# Local LLM Backend (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Speech AI Pipeline (STT & TTS)
# STT 제공자: local (로컬 Whisper ONNX), deepgram (Deepgram Nova-2 API), openai/groq (Whisper API), auto
STT_PROVIDER=local
# 한국어 최상위 정확도 로컬 모델 (대안: onnx-community/whisper-large-v3, onnx-community/whisper-small)
WHISPER_MODEL=onnx-community/whisper-large-v3-turbo
WHISPER_FALLBACK_MODEL=onnx-community/whisper-small
# 인식 언어 코드 (ko, en, ja, zh, auto)
STT_LANGUAGE=ko
# 인코더/디코더 모두 q8 양자화 권장 (Docker 메모리 절약 및 CPU 고속 추론, 여유 시 enc=fp32 가능)
STT_ENCODER_DTYPE=q8
STT_DECODER_DTYPE=q8
STT_NUM_BEAMS=1
STT_TEMPERATURE=0.0
STT_INITIAL_PROMPT="설아야, 안녕! 노래 틀어줘, 목소리 바꿔줘, 검색해줘."

# STT VAD(음성 감지) 민감도 & 노이즈 필터링 튜닝 파라미터
STT_SILENCE_DURATION_MS=950
STT_MIN_SPEECH_SECONDS=0.3
STT_MAX_SPEECH_SECONDS=30.0
STT_MIN_RMS_THRESHOLD=0.0035
STT_MIN_PEAK_THRESHOLD=0.015
STT_VAD_ENERGY_RATIO=0.08
STT_VAD_MIN_FRAME_RMS=0.003
STT_NOISE_GATE_ENABLED=true
STT_HIGHPASS_CUTOFF_HZ=75
STT_LOWPASS_CUTOFF_HZ=7600
STT_PRE_EMPHASIS_COEFF=0.12
STT_AGC_TARGET_PEAK=0.88
STT_AGC_MAX_GAIN=6.0

# (선택) 외부 초고속/초고정밀 STT API 연동 (STT_PROVIDER=deepgram|openai|groq|auto 시 사용)
# DEEPGRAM_API_KEY=your_deepgram_api_key
# DEEPGRAM_MODEL=nova-2
# STT_API_URL=https://api.openai.com/v1
# STT_API_KEY=your_openai_or_groq_api_key
# STT_API_MODEL=whisper-large-v3-turbo

TTS_PRESET=seola
COSYVOICE_INSTRUCT_TEXT="차갑고 감정이 절제된 어린 소녀의 목소리. 아리스보다 반 옥타브 낮고 차분한 톤으로, 억양의 높낮이 변화가 적고 기계처럼 또박또박 일정한 속도로 말한다."

# Self-Improvement Agent Paths (Optional)
# HERMES_BIN=/path/to/hermes
# AGY_BIN=/opt/homebrew/bin/agy
